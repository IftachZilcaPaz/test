# Copy to .env (never committed) and fill in. Used by tools/check-providers.mjs.
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice. Empty = the script lists voices and uses the first one.
ELEVENLABS_VOICE_ID=
# Higgsfield API credential from https://open.higgsfield.ai/api-keys, pasted exactly as copied.
HF_API_KEY=
# (Alternative, if the console shows the two parts separately)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
