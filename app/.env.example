# Copied to .env.local by `npm run setup` (which also fills a random secret).
# Session signing secret: at least 32 random characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local SQLite file. In production: libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=
# Media storage is picked automatically: Netlify Blobs on Netlify, Vercel Blob when
# BLOB_READ_WRITE_TOKEN is set, otherwise data/media. MEDIA_STORE=netlify|vercel|local forces one.
MEDIA_STORE=
BLOB_READ_WRITE_TOKEN=
# Claude API (scripts). Without it: free demo scripts.
ANTHROPIC_API_KEY=
# ElevenLabs (narration, eleven_v3 Hebrew). Needs Text to Speech + Voices(read) access.
ELEVENLABS_API_KEY=
# Higgsfield API (scenes), from open.higgsfield.ai. Without it: free demo scenes.
HF_API_KEY=
# Customer price = provider cost × this, in shekels (NEXT_PUBLIC_USD_TO_ILS rate, default 3.7).
NEXT_PUBLIC_PRICE_MULTIPLIER=3
# Demo "top up" button until a real payment provider is connected. Set to false in production.
ALLOW_DEMO_TOPUP=true
